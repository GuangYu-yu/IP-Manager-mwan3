#!/bin/sh
/usr/sbin/nft delete table inet portguard 2>/dev/null || true
/usr/sbin/nft -f - <<'NFTEOF'
table inet portguard {
	# ── 敲门探针（按 IP+端口 独立计数）──
	set probe_v4 {
		type ipv4_addr . inet_service
		flags dynamic,timeout; timeout 10s; size 65535
	}
	set probe_v6 {
		type ipv6_addr . inet_service
		flags dynamic,timeout; timeout 10s; size 65535
	}

	# ── 白名单（通过后按端口放行）──
	set allow_v4 {
		type ipv4_addr . inet_service
		flags dynamic,timeout; timeout 10m; size 65535
	}
	set allow_v6 {
		type ipv6_addr . inet_service
		flags dynamic,timeout; timeout 10m; size 65535
	}

	# ── 敲门阶段速率桶（50/s 超限软丢）──
	set rate_v4 {
		type ipv4_addr
		flags dynamic,timeout; timeout 20ms; size 65535
	}
	set rate_v6 {
		type ipv6_addr
		flags dynamic,timeout; timeout 20ms; size 65535
	}

	# ── 封禁名单（手动添加）──
	set ban_v4 {
		type ipv4_addr
		flags dynamic,timeout; timeout 1h; size 65535
	}
	set ban_v6 {
		type ipv6_addr
		flags dynamic,timeout; timeout 1h; size 65535
	}

	# ── 公共敲门逻辑 ──
	chain guard_core {
		tcp flags & (fin|syn|rst|psh|ack|urg) == 0 drop
		tcp flags & (fin|syn) == (fin|syn) drop
		tcp flags & (fin|syn|rst|psh|ack|urg) == (fin|psh|urg) drop
		tcp flags & (syn|ack|fin|rst) == ack drop

		ct state new limit rate over 80/second burst 40 packets drop

		meta nfproto ipv4 ct state new ip saddr @ban_v4 drop
		meta nfproto ipv6 ct state new ip6 saddr @ban_v6 drop

		meta nfproto ipv4 meta l4proto { tcp, udp } ct state new \
			ip saddr . th dport @allow_v4 \
			add @allow_v4 { ip saddr . th dport timeout 10m } accept
		meta nfproto ipv6 meta l4proto { tcp, udp } ct state new \
			ip6 saddr . th dport @allow_v6 \
			add @allow_v6 { ip6 saddr . th dport timeout 10m } accept

		meta nfproto ipv4 meta l4proto { tcp, udp } ct state new \
			ip saddr . th dport @probe_v4 \
			add @allow_v4 { ip saddr . th dport } reject
		meta nfproto ipv6 meta l4proto { tcp, udp } ct state new \
			ip6 saddr . th dport @probe_v6 \
			add @allow_v6 { ip6 saddr . th dport } reject

		meta nfproto ipv4 meta l4proto { tcp, udp } ct state new ip saddr @rate_v4 drop
		meta nfproto ipv6 meta l4proto { tcp, udp } ct state new ip6 saddr @rate_v6 drop
		meta nfproto ipv4 meta l4proto { tcp, udp } ct state new \
			add @rate_v4 { ip saddr timeout 20ms } \
			add @probe_v4 { ip saddr . th dport } reject
		meta nfproto ipv6 meta l4proto { tcp, udp } ct state new \
			add @rate_v6 { ip6 saddr timeout 20ms } \
			add @probe_v6 { ip6 saddr . th dport } reject
	}

	# ── 路由器本机入站 ──
	chain guard {
		type filter hook input priority -10; policy accept;

		ct state { established, related } accept
		ct state invalid drop
		iifname "br*" return
		iif "lo" accept

		jump guard_core
	}

	# ── 转发到内网设备 ──
	chain guard_fwd {
		type filter hook forward priority -10; policy accept;

		ct state { established, related } accept
		ct state invalid drop
		iifname "br*" return

		jump guard_core
	}
}
NFTEOF